@startuml
set separator none

skinparam {
  shadowing false
  arrowFontSize 15
  defaultTextAlignment center
  wrapWidth 100
  maxMessageSize 100
}
hide stereotype

skinparam rectangle<<_transparent>> {
  BorderColor transparent
  BackgroundColor transparent
  FontColor transparent
}

skinparam rectangle<<1>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
}
rectangle "==Container" <<1>>

skinparam hexagon<<2>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
}
hexagon "==Container, API" <<2>>

skinparam hexagon<<3>> {
  BackgroundColor #2e8b57
  FontColor #ffffff
  BorderColor #20613c
}
hexagon "==Container, API, Dodatek SI" <<3>>

skinparam hexagon<<4>> {
  BackgroundColor #8e44ad
  FontColor #ffffff
  BorderColor #632f79
}
hexagon "==Container, API, Dodatek SI, Odprto, R2" <<4>>

skinparam database<<5>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
}
database "==Container, Database" <<5>>

skinparam rectangle<<6>> {
  BackgroundColor #2e8b57
  FontColor #ffffff
  BorderColor #20613c
}
rectangle "==Container, Dodatek SI" <<6>>

skinparam database<<7>> {
  BackgroundColor #2e8b57
  FontColor #ffffff
  BorderColor #20613c
}
database "==Container, Dodatek SI, Database" <<7>>

skinparam person<<8>> {
  BackgroundColor #08427b
  FontColor #ffffff
  BorderColor #052e56
}
person "==Person" <<8>>

skinparam rectangle<<9>> {
  BackgroundColor #e67e22
  FontColor #ffffff
  BorderColor #a15817
}
rectangle "==Software System, Odprto" <<9>>

rectangle "." <<_transparent>> as 10
10 .[#707070,thickness=2].> 10 : "<color:#707070>Relationship"


@enduml