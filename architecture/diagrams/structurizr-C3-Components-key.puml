skinparam rectangle<<12>> {
  BackgroundColor #e67e22
  FontColor #ffffff
  BorderColor #a15817
}
rectangle "==Software System, Zunanji, Odprto" <<12>>

rectangle "." <<_transparent>> as 13
13 .[#707070,thickness=2].> 13 : "<color:#707070>Relationship"


