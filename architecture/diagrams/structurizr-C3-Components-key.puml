@startuml
set separator none

skinparam {
  shadowing false
  arrowFontSize 15
  defaultTextAlignment center
  wrapWidth 100
  maxMessageSize 100
}
hide stereotype

skinparam rectangle<<_transparent>> {
  BorderColor transparent
  BackgroundColor transparent
  FontColor transparent
}

skinparam rectangle<<1>> {
  BackgroundColor #85bbf0
  FontColor #000000
  BorderColor #5d82a8
}
rectangle "==Component" <<1>>

skinparam rectangle<<2>> {
  BackgroundColor #2e8b57
  FontColor #ffffff
  BorderColor #20613c
}
rectangle "==Component, Dodatek SI" <<2>>

skinparam rectangle<<3>> {
  BackgroundColor #e67e22
  FontColor #ffffff
  BorderColor #a15817
}
rectangle "==Component, Dodatek SI, Odprto" <<3>>

skinparam rectangle<<4>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
}
rectangle "==Container" <<4>>

skinparam hexagon<<5>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
}
hexagon "==Container, API" <<5>>

skinparam hexagon<<6>> {
  BackgroundColor #2e8b57
  FontColor #ffffff
  BorderColor #20613c
}
hexagon "==Container, API, Dodatek SI" <<6>>

skinparam database<<7>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
}
database "==Container, Database" <<7>>

skinparam rectangle<<8>> {
  BackgroundColor #2e8b57
  FontColor #ffffff
  BorderColor #20613c
}
rectangle "==Container, Dodatek SI" <<8>>

skinparam database<<9>> {
  BackgroundColor #2e8b57
  FontColor #ffffff
  BorderColor #20613c
}
