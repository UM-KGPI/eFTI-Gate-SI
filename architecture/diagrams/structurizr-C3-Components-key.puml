skinparam rectangle<<10>> {
  BackgroundColor #8e44ad
  FontColor #ffffff
  BorderColor #632f79
}
rectangle "==Container, Dodatek SI, Odprto, R2" <<10>>

skinparam queue<<11>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
}
