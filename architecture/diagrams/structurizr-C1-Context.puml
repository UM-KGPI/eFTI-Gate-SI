@startuml
set separator none
title eFTI Gate - System Context

left to right direction
skinparam ranksep 60
skinparam nodesep 30

skinparam {
  arrowFontSize 10
  defaultTextAlignment center
  wrapWidth 200
  maxMessageSize 100
}

hide stereotype

skinparam person<<Gospodarskisubjekt>> {
  BackgroundColor #8a8a8a
  FontColor #ffffff
  BorderColor #606060
  shadowing false
}
skinparam rectangle<<NacionalniseznamcertificiraniheFTIPlatform>> {
  BackgroundColor #e67e22
  FontColor #ffffff
  BorderColor #a15817
  shadowing false
}
skinparam rectangle<<ReferenčnieFTIGateRIinLaunchpad>> {
  BackgroundColor #b8860b
  FontColor #ffffff
  BorderColor #805d07
  shadowing false
}
skinparam rectangle<<SistemipristojnihorganovAAPAuthorisationRegistryUAP>> {
  BackgroundColor #e67e22
  FontColor #ffffff
  BorderColor #a15817
  shadowing false
}
skinparam rectangle<<Unijskireferenčniseznam>> {
  BackgroundColor #e67e22
  FontColor #ffffff
  BorderColor #a15817
  shadowing false
}
skinparam person<<UpravljaveceFTIGate>> {
  BackgroundColor #08427b
  FontColor #ffffff
  BorderColor #052e56
  shadowing false
}
skinparam person<<Uradnikpristojnegaorgana>> {
  BackgroundColor #8a8a8a
  FontColor #ffffff
  BorderColor #606060
  shadowing false
}
skinparam rectangle<<eDeliverySMLSMP>> {
  BackgroundColor #8a8a8a
  FontColor #ffffff
  BorderColor #606060
  shadowing false
}
skinparam rectangle<<eFTIGate>> {
  BackgroundColor #1168bd
  FontColor #ffffff
  BorderColor #0b4884
  shadowing false
}
skinparam rectangle<<eFTIGatedrugihDČ>> {
  BackgroundColor #8a8a8a
  FontColor #ffffff
  BorderColor #606060
  shadowing false
}
skinparam rectangle<<eFTIPlatformSI>> {
  BackgroundColor #8a8a8a
  FontColor #ffffff
  BorderColor #606060
  shadowing false
}
skinparam rectangle<<eFTIPlatformdrugihDČ>> {
  BackgroundColor #8a8a8a
  FontColor #ffffff
  BorderColor #606060
  shadowing false
}

rectangle "EU eFTI okolje" <<group1>> as group1 {
  skinparam RectangleBorderColor<<group1>> #cccccc
  skinparam RectangleFontColor<<group1>> #cccccc
  skinparam RectangleBorderStyle<<group1>> dashed

  rectangle "==eFTI Gate drugih DČ\n<size:10>[Software System]</size>\n\nMrežna topologija eFTI Gate." <<eFTIGatedrugihDČ>> as eFTIGatedrugihDČ
  rectangle "==Unijski referenčni seznam\n<size:10>[Software System]</size>\n\nStatusi certifikatov eFTI Platform (DU o certificiranju, v sprejemanju)." <<Unijskireferenčniseznam>> as Unijskireferenčniseznam
  rectangle "==eDelivery SML/SMP\n<size:10>[Software System]</size>\n\nDinamično odkrivanje eFTI Platform za #2." <<eDeliverySMLSMP>> as eDeliverySMLSMP
  rectangle "==eFTI Platform drugih DČ\n<size:10>[Software System]</size>\n\nPriključene na eFTI Gate drugih DČ." <<eFTIPlatformdrugihDČ>> as eFTIPlatformdrugihDČ
}

rectangle "Slovenija" <<group2>> as group2 {
  skinparam RectangleBorderColor<<group2>> #cccccc
  skinparam RectangleFontColor<<group2>> #cccccc
  skinparam RectangleBorderStyle<<group2>> dashed

  rectangle "==Sistemi pristojnih organov (AAP, Authorisation Registry, UAP)\n<size:10>[Software System]</size>\n\nAAP (čl. 4), Authorisation Registry (čl. 5) in UAP (čl. 7) Policije, FURS, IRSI in drugih organov. V eFTI Gate ali pri organih: odloči M2 (čl. 4(4))." <<SistemipristojnihorganovAAPAuthorisationRegistryUAP>> as SistemipristojnihorganovAAPAuthorisationRegistryUAP
  rectangle "==eFTI Platform (SI)\n<size:10>[Software System]</size>\n\neFTI Platform, certificirane v Sloveniji ali priključene po čl. 6(4)." <<eFTIPlatformSI>> as eFTIPlatformSI
  rectangle "==Nacionalni seznam certificiranih eFTI Platform\n<size:10>[Software System]</size>\n\nImenovani organ in organi za ugotavljanje skladnosti (akreditira Slovenska akreditacija)." <<NacionalniseznamcertificiraniheFTIPlatform>> as NacionalniseznamcertificiraniheFTIPlatform
  rectangle "==eFTI Gate\n<size:10>[Software System]</size>\n\nSlovenski eFTI Gate (čl. 6 IU 2024/1942) z search mechanism (čl. 8) in Registry of Identifiers (čl. 11)." <<eFTIGate>> as eFTIGate
}

rectangle "Testno okolje eFTI4LIVE" <<group3>> as group3 {
  skinparam RectangleBorderColor<<group3>> #cccccc
  skinparam RectangleFontColor<<group3>> #cccccc
  skinparam RectangleBorderStyle<<group3>> dashed

  rectangle "==Referenčni eFTI Gate (RI) in Launchpad\n<size:10>[Software System]</size>\n\nSidro skladnosti v integracijskem omrežju; TCT in varnostni testi s podpisanim poročilom." <<ReferenčnieFTIGateRIinLaunchpad>> as ReferenčnieFTIGateRIinLaunchpad
}

person "==Uradnik pristojnega organa\n<size:10>[Person]</size>\n\nPolicist, inšpektor ali carinik, ki med nadzorom zahteva podatke eFTI (čl. 1(3) IU 2024/1942)." <<Uradnikpristojnegaorgana>> as Uradnikpristojnegaorgana
person "==Upravljavec eFTI Gate\n<size:10>[Person]</size>\n\nSkrbnik pri MZIE ali izvajalcu vzdrževanja; nacionalna služba za pomoč (raven 2)." <<UpravljaveceFTIGate>> as UpravljaveceFTIGate
person "==Gospodarski subjekt\n<size:10>[Person]</size>\n\nPrevoznik, špediter, pošiljatelj ali prejemnik; podatke eFTI vodi na certificirani eFTI Platform." <<Gospodarskisubjekt>> as Gospodarskisubjekt

Uradnikpristojnegaorgana .[#707070,thickness=2].> SistemipristojnihorganovAAPAuthorisationRegistryUAP : "<color:#707070>Vloži zahtevo za dostop ali follow-up communication"
Gospodarskisubjekt .[#707070,thickness=2].> eFTIPlatformSI : "<color:#707070>Vodi podatke eFTI"
UpravljaveceFTIGate .[#707070,thickness=2].> eFTIGate : "<color:#707070>Upravlja eFTI Gate"
eFTIGate .[#707070,thickness=2].> UpravljaveceFTIGate : "<color:#707070>Alarmi"
SistemipristojnihorganovAAPAuthorisationRegistryUAP .[#707070,thickness=2].> eFTIGate : "<color:#707070>#3 G2A: zahteve prek UIL, iskanja, follow-up communication\n<color:#707070><size:8>[REST/JSON, mTLS]</size>"
eFTIGate .[#707070,thickness=2].> eFTIPlatformSI : "<color:#707070>#2 G2P: zahteve za eFTI dataset, follow-up communication\n<color:#707070><size:8>[AS4]</size>"
eFTIPlatformSI .[#707070,thickness=2].> eFTIGate : "<color:#707070>#2 P2G: nalaganje identifikatorjev, odgovori\n<color:#707070><size:8>[AS4]</size>"
eFTIGate .[#707070,thickness=2].> eFTIGatedrugihDČ : "<color:#707070>#1 G2G: posredovanje zahtev in iskanj\n<color:#707070><size:8>[AS4, statično odkrivanje]</size>"
eFTIGatedrugihDČ .[#707070,thickness=2].> eFTIGate : "<color:#707070>#1 G2G: zahteve in iskanja drugih DČ, odgovori\n<color:#707070><size:8>[AS4]</size>"
eFTIGatedrugihDČ .[#707070,thickness=2].> eFTIPlatformdrugihDČ : "<color:#707070>#2 G2P\n<color:#707070><size:8>[AS4]</size>"
eFTIGate .[#707070,thickness=2].> eDeliverySMLSMP : "<color:#707070>Odkrivanje eFTI Platform\n<color:#707070><size:8>[SML/SMP]</size>"
eFTIGate .[#707070,thickness=2].> Unijskireferenčniseznam : "<color:#707070>Sinhronizacija statusov certifikatov (R2)\n<color:#707070><size:8>[HTTPS]</size>"
eFTIGate .[#707070,thickness=2].> NacionalniseznamcertificiraniheFTIPlatform : "<color:#707070>Nacionalni vnosi certificiranih eFTI Platform\n<color:#707070><size:8>[HTTPS ali ročno]</size>"
eFTIGate .[#707070,thickness=2].> ReferenčnieFTIGateRIinLaunchpad : "<color:#707070>Testi skladnosti pred vstopom v mrežo\n<color:#707070><size:8>[AS4]</size>"
@enduml