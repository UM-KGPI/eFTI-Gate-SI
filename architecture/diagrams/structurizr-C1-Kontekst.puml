@startuml
set separator none
title Slovenska eFTI-vrata - System Context

left to right direction

!include <C4/C4>
!include <C4/C4_Context>

AddBoundaryTag("EU eFTI okolje", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
Boundary(group_1, "EU eFTI okolje", $tags="EU eFTI okolje") {
  System(TujaeFTIvrata, "Tuja eFTI-vrata", $descr="eFTI-vrata drugih držav članic (mrežna topologija).", $tags="", $link="")
  System(Unijskireferenčniseznamcertificiranihplatform, "Unijski referenčni seznam certificiranih platform", $descr="Seznam statusov certifikatov eFTI-platform; nacionalni vnosi pri imenovanem organu (DU o certificiranju, v sprejemanju).", $tags="", $link="")
  System(eDeliverySMLSMP, "eDelivery SML/SMP", $descr="Dinamično odkrivanje udeležencev za #2 (vrata–platforma).", $tags="", $link="")
  System(eFTIplatformevdrugihDČ, "eFTI-platforme v drugih DČ", $descr="Platforme, priključene na tuja vrata.", $tags="", $link="")
}

AddBoundaryTag("Slovenija", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
Boundary(group_2, "Slovenija", $tags="Slovenija") {
  System(AplikacijepristojnihorganovAAPUAP, "Aplikacije pristojnih organov (AAP/UAP)", $descr="Authority Access Point in uporabniške aplikacije Policije, FURS, IRSI in drugih organov. Obseg ločenega JN odprt (M2).", $tags="", $link="")
  System(CertificiraneeFTIplatformeSI, "Certificirane eFTI-platforme (SI)", $descr="Platforme gospodarskih subjektov, priključene na slovenska vrata (npr. pilot Trinet).", $tags="", $link="")
  System(Nacionalnigradnikieidentitete, "Nacionalni gradniki e-identitete", $descr="SI-PASS, SI-CAS, SIGEN-CA (MJU/MDP).", $tags="", $link="")
  System(SlovenskaeFTIvrata, "Slovenska eFTI-vrata", $descr="Nacionalna eFTI-vrata: posredujejo zahteve pristojnih organov platformam in tujim vratom, vodijo register identifikatorjev (IU 2024/1942).", $tags="", $link="")
}

AddBoundaryTag("Testno okolje (eFTI4LIVE)", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
Boundary(group_3, "Testno okolje (eFTI4LIVE)", $tags="Testno okolje (eFTI4LIVE)") {
  System(ReferenčnavrataRIinLaunchpad, "Referenčna vrata (RI) in Launchpad", $descr="Referenčna implementacija kot sidro skladnosti v integracijskem omrežju; Launchpad: TCT in varnostni testi s podpisanim poročilom.", $tags="", $link="")
}

Person(Uradnaosebapristojnegaorgana, "Uradna oseba pristojnega organa", $descr="Policist, inšpektor ali carinik, ki med nadzorom zahteva podatke eFTI.", $tags="", $link="")
Person(UpravljaveceFTIvrat, "Upravljavec eFTI-vrat", $descr="Skrbnik sistema pri MZIE ali izvajalcu vzdrževanja; nacionalna podpora (raven 2).", $tags="", $link="")
Person(Gospodarskisubjekt, "Gospodarski subjekt", $descr="Prevoznik, špediter, pošiljatelj ali prejemnik, ki podatke eFTI vodi na certificirani platformi.", $tags="", $link="")

Rel(Uradnaosebapristojnegaorgana, AplikacijepristojnihorganovAAPUAP, "Zahteva podatke eFTI med nadzorom", $techn="", $tags="", $link="")
Rel(Gospodarskisubjekt, CertificiraneeFTIplatformeSI, "Vodi podatke eFTI", $techn="", $tags="", $link="")
Rel(UpravljaveceFTIvrat, SlovenskaeFTIvrata, "Upravlja vrata", $techn="", $tags="", $link="")
Rel(AplikacijepristojnihorganovAAPUAP, SlovenskaeFTIvrata, "#3 G2A: dostop prek UIL, iskanje po identifikatorjih, nadaljnja komunikacija", $techn="REST/JSON, nacionalna izbira", $tags="", $link="")
