Rel(CertificiraneeFTIplatformeSI, SlovenskaeFTIvrata, "#2 P2G: nalaganje identifikatorjev, odgovori", $techn="AS4", $tags="", $link="")
Rel(SlovenskaeFTIvrata, TujaeFTIvrata, "#1 G2G: posredovanje zahtev in iskanj", $techn="AS4, statično odkrivanje", $tags="", $link="")
Rel(TujaeFTIvrata, SlovenskaeFTIvrata, "#1 G2G: zahteve tujih organov", $techn="AS4", $tags="", $link="")
Rel(TujaeFTIvrata, eFTIplatformevdrugihDČ, "#2 G2P", $techn="AS4", $tags="", $link="")
Rel(SlovenskaeFTIvrata, eDeliverySMLSMP, "Odkrivanje platform", $techn="SML/SMP", $tags="", $link="")
Rel(SlovenskaeFTIvrata, Unijskireferenčniseznamcertificiranihplatform, "Dnevni prenos statusov certifikatov", $techn="HTTPS", $tags="", $link="")
Rel(SlovenskaeFTIvrata, Nacionalnigradnikieidentitete, "Federacija identitet uradnih oseb", $techn="SAML/OIDC", $tags="", $link="")
Rel(SlovenskaeFTIvrata, ReferenčnavrataRIinLaunchpad, "Testi skladnosti pred vstopom v mrežo", $techn="AS4", $tags="", $link="")
Rel(SlovenskaeFTIvrata, UpravljaveceFTIvrat, "Alarmi", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
@enduml