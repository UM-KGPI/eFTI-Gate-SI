@startuml
set separator none
title Slovenska eFTI-vrata - Dynamic

left to right direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

System_Boundary("SlovenskaeFTIvrata_boundary", "Slovenska eFTI-vrata", $tags="") {
  Container(SlovenskaeFTIvrata.APIzapristojneorgane, "API za pristojne organe", $techn="REST/JSON, OIDC", $descr="REST vmesnik za AAP (#3); asinhron: organ prejme ID zahteve in periodično preverja odgovor. V RI del Gate Service.", $tags="", $link="")
  ContainerQueue(SlovenskaeFTIvrata.Sporočilniposrednik, "Sporočilni posrednik", $techn="RabbitMQ", $descr="Vrsta asinhronih zahtev pristojnih organov.", $tags="", $link="")
  ContainerDb(SlovenskaeFTIvrata.Podatkovnabazavrat, "Podatkovna baza vrat", $techn="PostgreSQL", $descr="Register identifikatorjev (trajno) in stanje zahtev.", $tags="", $link="")
  Container(SlovenskaeFTIvrata.DostopnatočkaeDelivery, "Dostopna točka eDelivery", $techn="Domibus (EK), AS4", $descr="AS4 dostopna točka za #1 (vrata–vrata) in #2 (vrata–platforma); PMode po TGD Annex 1.", $tags="", $link="")
  Container(SlovenskaeFTIvrata.Strežnikidentitetinavtorizacije, "Strežnik identitet in avtorizacije", $techn="OIDC (npr. Keycloak)", $descr="OIDC/OAuth2; v RI le primer (Keycloak). V SI federacija z nacionalnimi gradniki in Avtorizacijski register (TGD1 §5).", $tags="", $link="")
  Container(SlovenskaeFTIvrata.StoriteveFTIvratGateService, "Storitev eFTI-vrat (Gate Service)", $techn="Java 21+, Spring Boot", $descr="Jedro vrat: vmesniki, avtentikacija, obdelava zahtev, poteki, povezave na zunanje sisteme. V RI ena storitev, sestavljena iz knjižnic.", $tags="", $link="")
}

System(AplikacijepristojnihorganovAAPUAP, "Aplikacije pristojnih organov (AAP/UAP)", $descr="Authority Access Point in uporabniške aplikacije Policije, FURS, IRSI in drugih organov. Obseg ločenega JN odprt (M2).", $tags="", $link="")
System(CertificiraneeFTIplatformeSI, "Certificirane eFTI-platforme (SI)", $descr="Platforme gospodarskih subjektov, priključene na slovenska vrata (npr. pilot Trinet).", $tags="", $link="")

Rel(AplikacijepristojnihorganovAAPUAP, SlovenskaeFTIvrata.APIzapristojneorgane, "1. Zahteva z UIL", $techn="REST/JSON, nacionalna izbira", $tags="", $link="")
Rel(SlovenskaeFTIvrata.APIzapristojneorgane, SlovenskaeFTIvrata.Strežnikidentitetinavtorizacije, "2. Preveri žeton in pravice", $techn="", $tags="", $link="")
Rel(SlovenskaeFTIvrata.APIzapristojneorgane, SlovenskaeFTIvrata.StoriteveFTIvratGateService, "3. Predaja zahteve", $techn="", $tags="", $link="")
Rel(SlovenskaeFTIvrata.StoriteveFTIvratGateService, SlovenskaeFTIvrata.Sporočilniposrednik, "4. Asinhrona obdelava", $techn="AMQP", $tags="", $link="")
Rel(SlovenskaeFTIvrata.StoriteveFTIvratGateService, SlovenskaeFTIvrata.DostopnatočkaeDelivery, "5. Zahteva za nabor (FTI)", $techn="SOAP/HTTPS", $tags="", $link="")
Rel(SlovenskaeFTIvrata.DostopnatočkaeDelivery, CertificiraneeFTIplatformeSI, "6. #2 G2P zahteva", $techn="AS4 (+ REST kot nacionalna možnost)", $tags="", $link="")
Rel(CertificiraneeFTIplatformeSI, SlovenskaeFTIvrata.DostopnatočkaeDelivery, "7. Odgovor z naborom (≤ 50 s)", $techn="AS4", $tags="", $link="")
Rel(SlovenskaeFTIvrata.StoriteveFTIvratGateService, SlovenskaeFTIvrata.Podatkovnabazavrat, "8. Shrani odgovor", $techn="JDBC", $tags="", $link="")
Rel(AplikacijepristojnihorganovAAPUAP, SlovenskaeFTIvrata.APIzapristojneorgane, "9. Preverjanje odgovora (polling)", $techn="REST/JSON, nacionalna izbira", $tags="", $link="")

SHOW_LEGEND(true)
@enduml