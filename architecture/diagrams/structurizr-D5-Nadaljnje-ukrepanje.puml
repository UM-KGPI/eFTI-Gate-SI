@startuml
set separator none
title eFTI Gate - Dynamic

left to right direction
skinparam ranksep 60
skinparam nodesep 30

skinparam {
  arrowFontSize 10
  defaultTextAlignment center
  wrapWidth 200
  maxMessageSize 100
}

hide stereotype

skinparam rectangle<<SistemipristojnihorganovAAPAuthorisationRegistryUAP>> {
  BackgroundColor #e67e22
  FontColor #ffffff
  BorderColor #a15817
  shadowing false
}
skinparam rectangle<<eFTIGate.eDeliveryAccessPoint>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
  shadowing false
}
skinparam hexagon<<eFTIGate.eFTIGateAAPAPI3>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
  shadowing false
}
skinparam rectangle<<eFTIGate.eFTIGateService>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
  shadowing false
}
skinparam rectangle<<eFTIPlatformSI>> {
  BackgroundColor #8a8a8a
  FontColor #ffffff
  BorderColor #606060
  shadowing false
}
skinparam rectangle<<eFTIGate>> {
  BorderColor #0b4884
  FontColor #0b4884
  shadowing false
}

rectangle "eFTI Gate\n<size:10>[Software System]</size>" <<eFTIGate>> {
  hexagon "==eFTI Gate AAP API (#3)\n<size:10>[Container: REST/JSON, mTLS, OAuth 2.0]</size>\n\nOpenAPI: zahteve prek UIL, iskanja po identifikatorjih, follow-up communication; asinhrono (requestId). Pot /v1/aap/control/..." <<eFTIGate.eFTIGateAAPAPI3>> as eFTIGate.eFTIGateAAPAPI3
  rectangle "==eDelivery Access Point\n<size:10>[Container: Domibus (EK), AS4]</size>\n\nAS4 za #1 (statično odkrivanje) in #2 (SML/SMP); PMode po TGD Annex 1; ključi v HSM." <<eFTIGate.eDeliveryAccessPoint>> as eFTIGate.eDeliveryAccessPoint
  rectangle "==eFTI Gate Service\n<size:10>[Container: Java 21+, Spring Boot]</size>\n\nJedro eFTI Gate: vmesniki, obdelava zahtev, usmerjanje, revizijska sled. V RI ena storitev iz knjižnic." <<eFTIGate.eFTIGateService>> as eFTIGate.eFTIGateService
}

rectangle "==Sistemi pristojnih organov (AAP, Authorisation Registry, UAP)\n<size:10>[Software System]</size>\n\nAAP (čl. 4), Authorisation Registry (čl. 5) in UAP (čl. 7) Policije, FURS, IRSI in drugih organov. V eFTI Gate ali pri organih: odloči M2 (čl. 4(4))." <<SistemipristojnihorganovAAPAuthorisationRegistryUAP>> as SistemipristojnihorganovAAPAuthorisationRegistryUAP
rectangle "==eFTI Platform (SI)\n<size:10>[Software System]</size>\n\neFTI Platform, certificirane v Sloveniji ali priključene po čl. 6(4)." <<eFTIPlatformSI>> as eFTIPlatformSI

SistemipristojnihorganovAAPAuthorisationRegistryUAP .[#707070,thickness=2].> eFTIGate.eFTIGateAAPAPI3 : "<color:#707070>1. Sporočilo z UIL in ID izvorne zahteve\n<color:#707070><size:8>[REST/JSON, mTLS]</size>"
eFTIGate.eFTIGateAAPAPI3 .[#707070,thickness=2].> eFTIGate.eFTIGateService : "<color:#707070>2. Predaja"
eFTIGate.eFTIGateService .[#707070,thickness=2].> eFTIGate.eDeliveryAccessPoint : "<color:#707070>3. Posreduj\n<color:#707070><size:8>[SOAP/HTTPS]</size>"
eFTIGate.eDeliveryAccessPoint .[#707070,thickness=2].> eFTIPlatformSI : "<color:#707070>4. #2 G2P follow-up communication\n<color:#707070><size:8>[AS4]</size>"
eFTIPlatformSI .[#707070,thickness=2].> eFTIGate.eDeliveryAccessPoint : "<color:#707070>5. Potrdilo o prejemu in shranitvi\n<color:#707070><size:8>[AS4]</size>"
eFTIGate.eDeliveryAccessPoint .[#707070,thickness=2].> eFTIGate.eFTIGateService : "<color:#707070>6. Dostava potrdila\n<color:#707070><size:8>[JMS/WS]</size>"
SistemipristojnihorganovAAPAuthorisationRegistryUAP .[#707070,thickness=2].> eFTIGate.eFTIGateAAPAPI3 : "<color:#707070>7. Pridobi potrdilo\n<color:#707070><size:8>[REST/JSON, mTLS]</size>"
@enduml